function getAllScheduled() {
    return scheduled;
}

function getScheduledById(id) {
    return scheduled.find((m) => m.id === id);
}

function createScheduled(data) {
    const newScheduled = {
        id: scheduled.length + 1,
        kegiatan: data.kegiatan,
        tanggal: data.tanggal,
        waktu: data.waktu,
        status: data.status,
    };
    scheduled.push(newScheduled);
    return newScheduled;
}

function updateScheduled(id, updatedData) {
    const index = scheduled.findIndex((m) => m.id === id);
    if (index === -1) return null;

    scheduled[index] = { ...scheduled[index],
        kegiatan: updatedData.kegiatan || scheduled[index].kegiatan,
        tanggal: updatedData.tanggal || scheduled[index].tanggal,
        waktu: updatedData.waktu || scheduled[index].waktu,
        status: updatedData.status || scheduled[index].status,
     };
    return scheduled[index];
}

function deleteScheduled(id) {
    const index = scheduled.findIndex((m) => m.id === id);
    if (index === -1) return null;
    const deletedScheduled = scheduled.splice(index, 1);
    return deletedScheduled[0];
}

