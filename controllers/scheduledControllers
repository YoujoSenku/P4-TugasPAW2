const scheduledModel = require('../models/scheduledModels');

exports.getAllScheduled = (req, res) => {
    const scheduled = scheduledModel.getAllScheduled();
    res.status(200).json(scheduled);
};

exports.getScheduledById = (req, res) => {
    const id = parseInt(req.params.id);
    const data = scheduledModel.getScheduledById(id);
    if (!data) return res.status(404).json({ message: 'Data tidak ditemukan' });
    res.status(200).json(data);
}

exports.createScheduled = (req, res) => {
    const { kegiatan, tanggal, waktu, status } = req.body;
    const newScheduled = scheduledModel.createScheduled({
        kegiatan,
        tanggal,
        waktu,
        status
    });
    res.status(201).json(newScheduled);
}

exports.updateScheduled = (req, res) => {
    const id = parseInt(req.params.id);
    const updatedData = req.body;
    const updatedScheduled = scheduledModel.updateScheduled(id, updatedData);
    if (!updatedScheduled) return res.status(404).json({ message: 'Data tidak ditemukan' });
    res.status(200).json(updatedScheduled);
}

exports.deleteScheduled = (req, res) => {
    const id = parseInt(req.params.id);
    const deletedScheduled = scheduledModel.deleteScheduled(id);
    if (!deletedScheduled) return res.status(404).json({ message: 'Data tidak ditemukan' });
    res.status(200).json({ message: 'Data berhasil dihapus' }); 
}

