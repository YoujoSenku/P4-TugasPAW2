exports.getScheduledById = async (req, res, next) => {
    try {
        const data = await Scheduled.findById(req.params.id); // Mongoose query to find by ID

        // --- ALTERNATIF TANPA MONGOOSE (Hanya untuk array lokal) ---
        // const id = parseInt(req.params.id, 10);
        // const data = scheduledModel.getScheduledById(id);

        // If data is not found, create an error and pass it to the next middleware
        if (!data) {
            const err = new Error('Data tidak ditemukan');
            err.statusCode = 404;
            return next(err);
        }

        // If data is found, send it in the response
        res.status(200).json({
            status: 'success',
            data
        });
    } catch (error) {
        next(error); // Pass the error to the error handling middleware
    }
};

exports.createScheduled = async (req, res, next) => {
    try {
        const { kegiatan, tanggal, waktu, status } = req.body;

        // Validasi input: pastikan kegiatan dan tanggal tidak kosong
        if (!kegiatan || !tanggal) {
            const err = new Error('Field kegiatan dan tanggal wajib diisi!');
            err.statusCode = 400; // Bad Request
            return next(err);     // Lempar error ke middleware berikutnya (errorHandler)
        }

        // Buat data baru menggunakan Mongoose
        const newScheduled = await Scheduled.create({
            kegiatan,
            tanggal,
            waktu,
            status
        });

        // --- ALTERNATIF TANPA MONGOOSE (Hanya untuk array lokal) ---
        // const newScheduled = scheduledModel.createScheduled({
        //     kegiatan,
        //     tanggal,
        //     waktu,
        //     status
        // });

        res.status(201).json({
            status: 'success',
            data: newScheduled
        });
    } catch (error) {
        next(error); // Menangkap crash/error tak terduga
    }
};

exports.updateScheduled = async (req, res, next) => {
    try {
        // Update data menggunakan Mongoose
        const updatedScheduled = await Scheduled.findByIdAndUpdate(
            req.params.id,
            req.body,
            { new: true, runValidators: true } // Return data baru & jalankan validasi schema
        );

        // --- ALTERNATIF TANPA MONGOOSE (Hanya untuk array lokal) ---
        // const id = parseInt(req.params.id, 10);
        // const updatedData = req.body;
        // const updatedScheduled = scheduledModel.updateScheduled(id, updatedData);

        if (!updatedScheduled) {
            const err = new Error('Data tidak ditemukan');
            err.statusCode = 404;
            return next(err);
        }

        res.status(200).json({
            status: 'success',
            data: updatedScheduled
        });
    } catch (error) {
        next(error);
    }
};

