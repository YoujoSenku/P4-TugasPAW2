const scheduledModel = require('../models/scheduledModel');

exports.getAllScheduled = (req, res, next) => {
    try {
        let scheduled = [...scheduledModel.getAllScheduled()];

        // Filter by status if query parameter is provided
        if (req.query.status) {
            scheduled = scheduled.filter(item => 
                item.status.toLowerCase() === req.query.status.toLowerCase()
            );
        }

        // Sorting
        if (req.query.sort) {
            const isDescending = req.query.sort.startsWith('-');
            const field = isDescending ? req.query.sort.substring(1) : req.query.sort;

            scheduled.sort((a, b) => {
                if (a[field] < b[field]) return isDescending ? 1 : -1;
                if (a[field] > b[field]) return isDescending ? -1 : 1;
                return 0;
            });
        }

        // Pagination
        const page = parseInt(req.query.page, 10) || 1;
        let limit = parseInt(req.query.limit, 10) || 5;

        const MAX_LIMIT = 10;
        if (limit > MAX_LIMIT) {
            limit = MAX_LIMIT;
        }

        const totalData = scheduled.length;
        const startIndex = (page - 1) * limit;
        const endIndex = startIndex + limit;
        let paginatedData = scheduled.slice(startIndex, endIndex);

        // Field selection (Projection)
        if (req.query.fields) {
            const fieldList = req.query.fields.split(',').map(f => f.trim());
            
            paginatedData = paginatedData.map(item => {
                const filteredItem = {};
                fieldList.forEach(field => {
                    if (item[field] !== undefined) {
                        filteredItem[field] = item[field];
                    }
                });
                return filteredItem;
            });
        }

        res.status(200).json({
            status: 'success',
            results: paginatedData.length,
            pagination: {
                totalData,
                currentPage: page,
                totalPages: Math.ceil(totalData / limit),
                limit
            },
            data: paginatedData
        });
    } catch (error) {
        next(error); // Pass the error to the error handling middleware
    }
};

exports.getScheduledById = (req, res, next) => {
    try {
        const id = parseInt(req.params.id, 10);
        const data = scheduledModel.getScheduledById(id);

        // If data is not found, create an error and pass it to the next middleware
        if (!data) {
            const err = new Error('Data tidak ditemukan');
            err.statusCode = 404;
            return next(err);
        }

        // If data is found, send it in the response
        res.status(200).json({
            status: 'success',
            data
        });
    } catch (error) {
        next(error); // Pass the error to the error handling middleware
    }
};

exports.createScheduled = (req, res, next) => {
    try {
        const { kegiatan, tanggal, waktu, status } = req.body;

        // Validasi input: pastikan kegiatan dan tanggal tidak kosong
        if (!kegiatan || !tanggal) {
            const err = new Error('Field kegiatan dan tanggal wajib diisi!');
            err.statusCode = 400; // Bad Request
            return next(err);     // Lempar error ke middleware berikutnya (errorHandler)
        }

        const newScheduled = scheduledModel.createScheduled({
            kegiatan,
            tanggal,
            waktu,
            status
        });

        res.status(201).json({
            status: 'success',
            data: newScheduled
        });
    } catch (error) {
        next(error); // Menangkap crash/error tak terduga
    }
};

exports.updateScheduled = (req, res, next) => {
    try {
        const id = parseInt(req.params.id, 10);
        const updatedData = req.body;
        const updatedScheduled = scheduledModel.updateScheduled(id, updatedData);

        if (!updatedScheduled) {
            const err = new Error('Data tidak ditemukan');
            err.statusCode = 404;
            return next(err);
        }

        res.status(200).json({
            status: 'success',
            data: updatedScheduled
        });
    } catch (error) {
        next(error);
    }
};

exports.deleteScheduled = (req, res, next) => {
    try {
        const id = parseInt(req.params.id, 10);
        const deletedScheduled = scheduledModel.deleteScheduled(id);

        if (!deletedScheduled) {
            const err = new Error('Data tidak ditemukan');
            err.statusCode = 404;
            return next(err);
        }

        res.status(200).json({
            status: 'success',
            message: 'Data berhasil dihapus'
        });
    } catch (error) {
        next(error);
    }
};

